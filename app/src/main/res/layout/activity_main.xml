<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F4F7F3" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Barrio Alerta" android:textColor="#123D35"
            android:textSize="29sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Reporta problemas de tu comunidad"
            android:textColor="#52635D" android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:cardCornerRadius="18dp"
            app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Ubicación y clima" android:textColor="#123D35"
                    android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/location_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Ubicación no obtenida" android:textColor="#52635D" />
                <TextView android:id="@+id/weather_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="Consulta el clima al obtener ubicación" android:textColor="#52635D" />
                <com.google.android.material.button.MaterialButton android:id="@+id/location_button"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Usar mi ubicación" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/add_button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Nuevo reporte"
            app:icon="@android:drawable/ic_input_add" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Reportes guardados"
            android:textColor="#123D35" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:id="@+id/empty_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Aún no hay reportes. Crea el primero."
            android:textColor="#52635D" />
        <LinearLayout android:id="@+id/report_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
